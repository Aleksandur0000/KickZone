@model List<ShoesModel>
@{
    ViewData["Title"] = "Продукти";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Продукти</h3>
    <a asp-action="Create" class="btn btn-success">+ Нов продукт</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Име</th>
            <th>Марка</th>
            <th>Категория</th>
            <th>Цена</th>
            <th>Размер</th>
            <th>Наличност</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.Brand</td>
                <td>@s.CategoryName</td>
                <td>@s.Price.ToString("F2") €</td>
                <td>@s.Size</td>
                <td>@s.Stock</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Редактирай</a>
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Сигурен ли си, че искаш да изтриеш този продукт?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@s.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
