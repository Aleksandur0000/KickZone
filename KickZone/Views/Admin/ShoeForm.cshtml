@model KickZone.Models.ViewModels.ShoeFormViewModel
@{
    var isEdit = Model.Shoe.Id > 0;
    ViewData["Title"] = isEdit ? "Редактирай продукт" : "Нов продукт";
}

<h3>@(isEdit ? "Редактирай продукт" : "Нов продукт")</h3>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="col-md-8">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Shoe.Id" />

    <div class="mb-3">
        <label class="form-label">Име *</label>
        <input asp-for="Shoe.Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Описание</label>
        <textarea asp-for="Shoe.Description" class="form-control" rows="3"></textarea>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Цена (€) *</label>
            <input asp-for="Shoe.Price" type="number" step="0.01" min="0" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Размер (EU) *</label>
            <input asp-for="Shoe.Size" type="number" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Наличност</label>
            <input asp-for="Shoe.Stock" type="number" min="0" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Марка *</label>
            <input asp-for="Shoe.Brand" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Цвят *</label>
            <input asp-for="Shoe.Color" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Категория *</label>
            <select asp-for="Shoe.CategoryId" class="form-select" required>
                <option value="">-- Избери --</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Път към снимка</label>
        <input asp-for="Shoe.ImageUrl" class="form-control" placeholder="/Images/adidas.jpg" />
    </div>

    <button type="submit" class="btn btn-primary">Запази</button>
    <a asp-action="Shoes" class="btn btn-outline-secondary">Отказ</a>
</form>
