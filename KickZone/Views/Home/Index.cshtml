@model KickZone.Models.ViewModels.CatalogViewModel
@{
    ViewData["Title"] = "Начало";
}

<h1 class="mb-4">KickZone</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">Търсене</label>
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Име или марка" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Категория</label>
        <select name="categoryId" class="form-select">
            <option value="">Всички</option>
            @foreach (var c in Model.Categories)
            {
                if (Model.CategoryId == c.Id)
                {
                    <option value="@c.Id" selected>@c.Name</option>
                }
                else
                {
                    <option value="@c.Id">@c.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Марка</label>
        <select name="brand" class="form-select">
            <option value="">Всички</option>
            @foreach (var b in Model.Brands)
            {
                if (Model.Brand == b)
                {
                    <option value="@b" selected>@b</option>
                }
                else
                {
                    <option value="@b">@b</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Филтрирай</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
    </div>
</form>

@if (Model.Shoes.Count == 0)
{
    <p class="text-muted">Няма продукти по избраните филтри.</p>
}
else
{
    <div class="row g-4">
        @foreach (var product in Model.Shoes)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card product-card h-100">
                    <div class="product-image-wrapper">
                        <img src="@product.DisplayImageUrl"
                             class="product-image"
                             alt="@product.Name" />
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="product-title">@product.Name</h5>
                        <p class="text-muted mb-1">@product.Brand · @product.CategoryName</p>
                        <p class="product-price">@product.Price.ToString("F2") €</p>
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                           class="btn btn-product mt-auto">
                            Виж продукта
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
